[Unit]
Description=gas-city-dashboard — editorial ambient dashboard for a single gc operator (localhost-only, port 8082)
Documentation=file://%h/gascity-dashboard/specs/architecture/overview.md
After=network-online.target
Wants=network-online.target

# Template via systemd's %h (user home) so the unit works on any operator's host
# when installed under `systemctl --user`. The repo clones to ~/gascity-dashboard
# (the gastownhall/gascity-dashboard default); if yours lives elsewhere, repoint
# the paths below.

[Service]
Type=simple
WorkingDirectory=%h/gascity-dashboard
Environment=NODE_ENV=production
Environment=PORT=8082
# A systemd user service does not inherit the login shell's PATH, so state one.
# ~/.local/bin leads so a per-user node wins over a system one. If yours is
# elsewhere (nvm, fnm, and asdf keep theirs under their own roots), add it here.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GC_SUPERVISOR_URL=http://127.0.0.1:8372
Environment=GC_CITY_NAME=gas-city
Environment=ADMIN_AUDIT_LOG_PATH=%h/.gc/events.jsonl
Environment=ADMIN_FRONTEND_DIST=%h/gascity-dashboard/frontend/dist
# Name the missing build step, which is what a redeploy that skipped `npm run
# build` actually hits — node would otherwise fail with a MODULE_NOT_FOUND
# stack trace naming an internal loader path. (A wrong repo path never reaches
# here: systemd aborts on WorkingDirectory at 200/CHDIR first, saying so.)
ExecStartPre=/bin/sh -c 'test -f %h/gascity-dashboard/backend/dist/server.js || { echo "gas-city-dashboard: %h/gascity-dashboard/backend/dist/server.js not found — is the repo at ~/gascity-dashboard and built (npm install && npm run build)?" >&2; exit 1; }'
# The frontend bundle the UI is served from. A stale or mis-edited
# ADMIN_FRONTEND_DIST otherwise starts, binds the port, and reads active/green
# while GET / returns 404 — a dead dashboard (backend/src/app.ts:134-139
# mountFrontend: existsSync -> log -> API-only, no throw). Assert the *configured*
# path so the check moves with the var. It must be ABSOLUTE: mountFrontend
# resolves a relative value from backend/ (path.resolve(__dirname, '..', value)),
# a different directory than this check's cwd (WorkingDirectory=repo root), so a
# relative value would pass here yet 404 there. Reject relative up front.
#
# The value is passed POSITIONALLY as "$1" — never written as ${ADMIN_FRONTEND_DIST}
# inside the sh -c script text. systemd substitutes ${VAR} into the command line
# before sh parses it, so a value spliced into the script body is re-parsed as
# shell PROGRAM TEXT: $(...) in it executes as the service user at start. Passing
# it after the script makes sh treat it as opaque data. Do not inline it back.
ExecStartPre=/bin/sh -c 'case "$1" in /*) ;; *) echo "gas-city-dashboard: ADMIN_FRONTEND_DIST must be an absolute path, got: $1" >&2; exit 1 ;; esac; test -f "$1/index.html" || { echo "gas-city-dashboard: frontend bundle missing at $1 — build the frontend (npm run build), or fix the ADMIN_FRONTEND_DIST line in this unit" >&2; exit 1; }' _ "${ADMIN_FRONTEND_DIST}"
# Same guard for the interpreter. `/usr/bin/env node` already names a missing
# node and exits 127; this adds the one thing it can't know — which line of
# this unit to edit.
ExecStartPre=/bin/sh -c 'command -v node >/dev/null 2>&1 || { echo "gas-city-dashboard: no runnable \"node\" on this unit PATH — install Node.js, or add its directory to the Environment=PATH line in this unit" >&2; exit 1; }'
# Refuse to start if the address we bind is already held. This probes the bind
# itself rather than filtering `ss`, because no ss filter is correct here: a wide
# `sport = :8082` aborts on tailscale's own <tailnet-ip>:8082 (which proxies INTO
# loopback), while a narrow `src 127.0.0.1:8082` misses the 0.0.0.0 and
# dual-stack [::] wildcards that really do block the bind. Rationale and the
# proofs live in the script. ${PORT} is passed as an argument, so the guard
# tracks the Environment=PORT above and cannot drift off it.
ExecStartPre=/usr/bin/env node %h/gascity-dashboard/deploy/assert-port-free.mjs 127.0.0.1 "${PORT}"
ExecStart=/usr/bin/env node %h/gascity-dashboard/backend/dist/server.js
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal
# Hardening. The service appends its audit log under %h/.gc
# (ADMIN_AUDIT_LOG_PATH) and reads the checkout it runs from.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=%h/.gc %h/gascity-dashboard
ProtectHome=read-only
PrivateTmp=true
# NO PrivateDevices / ProtectKernelModules: both imply a CapabilityBoundingSet
# drop, which needs CAP_SETPCAP *effective* — no unprivileged `systemctl --user`
# manager has it, so systemd rejects the unit at 218/CAPABILITIES before
# ExecStart. They drop caps an unprivileged process never had. System units only.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
LockPersonality=true
# NO MemoryDenyWriteExecute: it blocks the mprotect() V8's JIT needs, so node
# SIGTRAPs at startup (code=dumped/status=TRAP) before running a line of the
# server. Re-add only alongside `node --jitless`. This same fault was reported
# and fixed independently by Tudor Saitoc in gastownhall/gascity-dashboard#174.
SystemCallArchitectures=native

[Install]
WantedBy=default.target
